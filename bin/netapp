#!/usr/bin/env python3
"""Runs the netapp CLI straight from a checkout, without installing it
(the installed equivalent is the `netapp` entry point from pyproject.toml)."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from netapp.cli import main  # noqa: E402

main()
