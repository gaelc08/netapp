# Copy to .env (in the directory you run netapp from) or to
# ~/.config/netapp/.env, and fill in what you use. Never commit it.
# Loaded automatically at startup (see --env-file to use another path).
# Uncomment only what you set: an empty VAR= would override a value
# already exported in your shell. Every value here can also be given on
# the command line; the flag wins.

# Cohesity API key (else --cohesity-apikey, else a hidden prompt)
# COHESITY_APIKEY=

# CA that signed the Cohesity clusters' certificates, if internal
# (else --cohesity-ca-bundle; default: system CA store)
# COHESITY_CA_BUNDLE=

# --api rest only: basic auth password for --user (else --password, else
# a hidden prompt), or a client certificate + key instead
# ONTAP_PASSWORD=
# ONTAP_CERT_FILE=
# ONTAP_KEY_FILE=

# --api rest only: CA that signed the ONTAP clusters' certificates
# (else --ca-bundle; default: system CA store)
# ONTAP_CA_BUNDLE=
